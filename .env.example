# Deployment guard: ID of the newly created Afrimind_AI project (must match .neon).
NEON_DEPLOY_PROJECT_ID=""

# Neon Postgres: pooled application connection and direct schema/admin connection.
DATABASE_URL="postgresql://USER:PASSWORD@ep-example-pooler.us-east-1.aws.neon.tech/neondb?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://USER:PASSWORD@ep-example.us-east-1.aws.neon.tech/neondb?sslmode=require"

# Same JWT secret on Neon and Vercel preserves existing sessions.
JWT_SECRET=""
# Random server-only secret shared by the Vercel proxy and Neon Function.
ORIGIN_SECRET=""
# Vercel: invocation URL from `neon functions get api`; local development uses :3001.
NEON_BACKEND_URL="http://localhost:3001"
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# Only needed when explicitly seeding an EMPTY database.
ADMIN_EMAIL="admin@afrimindai.com"
ADMIN_PASSWORD=""

# Neon injects these into Functions; `neon env pull` supplies local values.
AWS_ENDPOINT_URL_S3=""
AWS_REGION="us-east-1"
AWS_ACCESS_KEY_ID=""
AWS_SECRET_ACCESS_KEY=""

OPENAI_API_KEY=""
SMTP_HOST=""
TWILIO_ACCOUNT_SID=""
NEXT_PUBLIC_FORMSPREE_ID=""
NEXT_PUBLIC_WHATSAPP_NUMBER="231775592486"
